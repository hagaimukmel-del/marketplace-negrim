# Copy to .env.local for development. On Vercel these live in Project → Settings →
# Environment Variables. Never commit real values — .env.local is gitignored.

# ---- Supabase -----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Read-only, safe in the browser. Reaches products, categories, supplier_offers
# and volume_pricing only; every other table has RLS on with no policy.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Bypasses RLS entirely. Server-only — lib/supabase-admin.ts imports `server-only`
# so a client component importing it fails the build rather than leaking it.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Operator console ---------------------------------------------------------
# The /admin gate. Both are required and the app fails closed without them.
ADMIN_PASSWORD=            # 8+ characters
ADMIN_SECRET=              # 16+ characters; signs the session cookie and the
                           # supplier order-confirmation links

# ---- Email --------------------------------------------------------------------
# Absent RESEND_API_KEY is a supported state, not a broken one: messages are
# logged in full and nothing is sent. An order never fails because a
# notification could not go out.
RESEND_API_KEY=

# The sending address. Needs a verified domain — nagarimb2b.com once it is bought
# and its DNS records are in place. Until then Resend's shared sender works, but
# only delivers to the address that owns the Resend account.
EMAIL_FROM=שוק הנגרים <orders@nagarimb2b.com>

# THE SAFETY VALVE. Messages to a business whose name contains "ניסיון" go here
# instead of the real recipient, with a banner naming who they were meant for.
# Every other business gets its real mail. Name test suppliers and carpenters
# with "ניסיון" and they can never email a real company.
EMAIL_TEST_RECIPIENT=nagarim.b2b@gmail.com

# Where a supplier hitting "reply" ends up.
EMAIL_REPLY_TO=nagarim.b2b@gmail.com

# Where "a new supplier applied" goes. Falls back to EMAIL_REPLY_TO.
# Deliberately NOT used for orders: those are watched in the console, and a
# message per order only teaches you to ignore them.
ADMIN_EMAIL=

# ---- Staging --------------------------------------------------------------------
# There are two Supabase projects: production (marketplace-negrim) and staging
# (marketplace-negrim-staging). Local development and Vercel Preview use staging;
# only Vercel Production uses the live database.
#
# On staging set both of these. The label draws a yellow strip across every page;
# the redirect sends every email to EMAIL_TEST_RECIPIENT, whatever the business name.
NEXT_PUBLIC_ENV_LABEL=
EMAIL_REDIRECT_ALL=
#
# Migrations: `npm run db:push` applies to production (the linked project),
# `npm run db:push:staging` to staging. Staging credentials live in
# .env.staging.local (gitignored): STAGING_PROJECT_REF, STAGING_DB_PASSWORD,
# STAGING_SUPABASE_URL, STAGING_ANON_KEY, STAGING_SERVICE_ROLE_KEY.
# A copy of the production .env.local is kept as .env.prod.local, which Next.js
# never loads.

# ---- Links --------------------------------------------------------------------
# The address links in emails point at. Vercel's own hostname is used when this
# is unset, which is right until the domain is connected — but a link in an email
# outlives the deployment that sent it, so set this in production.
NEXT_PUBLIC_SITE_URL=https://nagarimb2b.com
